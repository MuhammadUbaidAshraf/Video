<%- style = `
<style>
    .success-container {
        max-width: 800px;
        margin: 3rem auto;
        padding: 2rem;
    }
    .success-header {
        text-align: center;
        margin-bottom: 3rem;
    }
    .success-icon {
        font-size: 5rem;
        color: #28a745;
        margin-bottom: 1rem;
        animation: scaleIn 0.5s ease-out;
    }
    @keyframes scaleIn {
        from { transform: scale(0); }
        to { transform: scale(1); }
    }
    .success-title {
        color: #28a745;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    .order-number {
        font-size: 1.2rem;
        color: #666;
        margin-top: 0.5rem;
    }
    .order-number span {
        color: #0066ff;
        font-weight: 600;
    }
    .success-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        padding: 2rem;
        margin-bottom: 1.5rem;
    }
    .success-card h5 {
        color: #0066ff;
        margin-bottom: 1.5rem;
        font-weight: 600;
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 0.5rem;
    }
    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
    }
    .info-item {
        padding: 0.75rem;
        background: #f8f9fa;
        border-radius: 5px;
    }
    .info-label {
        font-size: 0.85rem;
        color: #666;
        margin-bottom: 0.25rem;
    }
    .info-value {
        font-weight: 600;
        color: #333;
    }
    .item-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .item-list li {
        display: flex;
        justify-content: space-between;
        padding: 1rem;
        border-bottom: 1px solid #e9ecef;
    }
    .item-list li:last-child {
        border-bottom: none;
    }
    .summary-totals {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 5px;
    }
    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
    }
    .summary-row.total {
        border-top: 2px solid #0066ff;
        margin-top: 1rem;
        padding-top: 1rem;
        font-size: 1.3rem;
        font-weight: 700;
        color: #0066ff;
    }
    .action-buttons {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }
    .btn-primary-custom {
        flex: 1;
        background: #0066ff;
        color: white;
        padding: 1rem;
        border: none;
        border-radius: 5px;
        text-decoration: none;
        text-align: center;
        font-weight: 600;
        transition: all 0.3s;
    }
    .btn-primary-custom:hover {
        background: #0052cc;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0, 102, 255, 0.3);
    }
    .btn-secondary-custom {
        flex: 1;
        background: #6c757d;
        color: white;
        padding: 1rem;
        border: none;
        border-radius: 5px;
        text-decoration: none;
        text-align: center;
        font-weight: 600;
        transition: all 0.3s;
    }
    .btn-secondary-custom:hover {
        background: #5a6268;
        color: white;
    }
    .status-badge {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: #28a745;
        color: white;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
    }
    @media (max-width: 768px) {
        .action-buttons {
            flex-direction: column;
        }
        .info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
` %>

<div class="success-container">
    <div class="success-header">
        <div class="success-icon">✓</div>
        <h1 class="success-title">Order Placed Successfully!</h1>
        <p class="lead">Thank you for your order. We'll send you a confirmation email shortly.</p>
        <% if (order && order.orderNumber) { %>
            <p class="order-number">
                Order Number: <span><%= order.orderNumber %></span>
            </p>
        <% } %>
    </div>

    <% if (order) { %>
        <!-- Order Status -->
        <div class="success-card">
            <h5>📦 Order Status</h5>
            <div class="text-center" style="padding: 1rem;">
                <span class="status-badge"><%= order.status %></span>
                <p class="text-muted mt-2">
                    Your order has been placed and will be processed shortly.
                </p>
            </div>
        </div>

        <!-- Customer Information -->
        <div class="success-card">
            <h5>📍 Shipping Information</h5>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Name</div>
                    <div class="info-value"><%= order.customerInfo.fullname %></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Email</div>
                    <div class="info-value"><%= order.customerInfo.email %></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Phone</div>
                    <div class="info-value"><%= order.customerInfo.phone %></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Address</div>
                    <div class="info-value">
                        <%= order.customerInfo.address %><br>
                        <%= order.customerInfo.city %>, <%= order.customerInfo.postal %><br>
                        <%= order.customerInfo.country %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Information -->
        <div class="success-card">
            <h5>💳 Payment Details</h5>
            <div class="info-item">
                <div class="info-label">Payment Method</div>
                <div class="info-value">
                    <% if (order.paymentMethod === 'card') { %>
                        Credit/Debit Card
                        <% if (order.cardDetails && order.cardDetails.lastFourDigits) { %>
                            (**** <%= order.cardDetails.lastFourDigits %>)
                        <% } %>
                    <% } else if (order.paymentMethod === 'cod') { %>
                        Cash on Delivery
                    <% } else if (order.paymentMethod === 'wallet') { %>
                        Digital Wallet
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <div class="success-card">
            <h5>🛍️ Order Items</h5>
            <ul class="item-list">
                <% if (order.items && order.items.length > 0) { %>
                    <% order.items.forEach(item => { %>
                        <li>
                            <div>
                                <strong><%= item.name %></strong><br>
                                <span class="text-muted">
                                    PKR <%= item.price.toFixed(2) %> × <%= item.quantity %>
                                </span>
                            </div>
                            <div>
                                <strong>PKR <%= item.subtotal.toFixed(2) %></strong>
                            </div>
                        </li>
                    <% }) %>
                <% } %>
            </ul>
        </div>

        <!-- Order Summary -->
        <div class="success-card">
            <h5>💰 Order Summary</h5>
            <div class="summary-totals">
                <div class="summary-row">
                    <span>Subtotal:</span>
                    <span>PKR <%= order.pricing.subtotal.toFixed(2) %></span>
                </div>
                <div class="summary-row">
                    <span>Shipping:</span>
                    <span>PKR <%= order.pricing.shipping.toFixed(2) %></span>
                </div>
                <div class="summary-row">
                    <span>Tax:</span>
                    <span>PKR <%= order.pricing.tax.toFixed(2) %></span>
                </div>
                <% if (order.pricing.discount > 0) { %>
                    <div class="summary-row" style="color: #28a745;">
                        <span>Discount (<%= order.pricing.couponCode %>):</span>
                        <span>- PKR <%= order.pricing.discount.toFixed(2) %></span>
                    </div>
                <% } %>
                <div class="summary-row total">
                    <span>Total Paid:</span>
                    <span>PKR <%= order.pricing.total.toFixed(2) %></span>
                </div>
            </div>
        </div>

        <!-- What's Next -->
        <div class="success-card">
            <h5>📧 What's Next?</h5>
            <ul style="line-height: 2;">
                <li>You'll receive an order confirmation email at <strong><%= order.customerInfo.email %></strong></li>
                <li>We'll send you tracking information once your order ships</li>
                <li>Estimated delivery: 3-5 business days</li>
                <li>For any questions, contact us at support@bevideo.com</li>
            </ul>
        </div>
    <% } %>

    <!-- Action Buttons -->
    <div class="action-buttons">
        <a href="/" class="btn-primary-custom">
            🏠 Continue Shopping
        </a>
        <a href="/order/track?orderId=<%= order._id %>" class="btn-secondary-custom">
            📍 Track Order
        </a>
    </div>
</div>

<%- script = `
<script>
    // Clear cart from localStorage on page load
    localStorage.removeItem('cart');
    
    // Update cart count
    if (typeof updateCartCount === 'function') {
        updateCartCount();
    }
</script>
` %>

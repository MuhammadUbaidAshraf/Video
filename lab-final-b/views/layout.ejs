<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= typeof title !== 'undefined' ? title : 'beVideo' %> | beVideo Productions</title>

    <meta name="description"
          content="<%= typeof metaDescription !== 'undefined'
            ? metaDescription
            : 'Professional video production services' %>">

    <meta name="keywords" content="video production, videography, corporate videos">
    <meta name="author" content="beVideo Productions">

    <link rel="icon" href="/images/assets/favicon.ico">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">

    <%- style %>
</head>

<body class="<%= pageClass || '' %>">

    <%- include('partials/header') %>

    <main id="main-content">
        <%- body %>
    </main>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/javascripts/cart.js"></script>

    <%- script %>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof updateCartCount === 'function') {
                updateCartCount();
            }
        });
    </script>
</body>
</html>

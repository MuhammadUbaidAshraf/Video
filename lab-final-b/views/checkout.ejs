<%- style = `
<link rel="stylesheet" href="/stylesheets/checkout-style.css">
<style>
    .coupon-section {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 5px;
        margin-bottom: 1rem;
    }
    .coupon-input-group {
        display: flex;
        gap: 0.5rem;
    }
    .coupon-input-group input {
        flex: 1;
    }
    .coupon-badge {
        display: inline-block;
        padding: 0.25rem 0.5rem;
        background: #28a745;
        color: white;
        border-radius: 3px;
        font-size: 0.85rem;
        margin-left: 0.5rem;
    }
</style>
` %>

<div class="container py-4">
    <div class="progress-steps">
        <div class="step">Cart</div>
        <div class="step">Address</div>
        <div class="step active">Payment / Checkout</div>
        <div class="step">Review</div>
    </div>

    <form id="checkoutForm" novalidate>
        <div class="row g-4">

            <div class="col-12 col-md-7">
                <div class="card mb-4">
                    <div class="card-body">
                        <h5>Customer & Shipping Information</h5>

                        <div class="row g-3 mt-2">
                            <div class="col-12">
                                <div class="form-floating">
                                    <input type="text" id="fullname" class="form-control" placeholder="Full Name" required>
                                    <label for="fullname">Full Name</label>
                                    <div class="invalid-feedback">Full name must be at least 3 characters.</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="email" id="email" class="form-control" placeholder="Email" required>
                                    <label for="email">Email</label>
                                    <div class="invalid-feedback">Please enter a valid email.</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="tel" id="phone" class="form-control" placeholder="Phone" required>
                                    <label for="phone">Phone</label>
                                    <div class="invalid-feedback">Phone must be digits only.</div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <input type="text" id="address" class="form-control" placeholder="Address" required>
                                    <label for="address">Address</label>
                                    <div class="invalid-feedback">Address is required.</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" id="city" class="form-control" placeholder="City" required>
                                    <label for="city">City</label>
                                    <div class="invalid-feedback">City is required.</div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-floating">
                                    <input type="text" id="postal" class="form-control" placeholder="Postal Code" required>
                                    <label for="postal">Postal Code</label>
                                    <div class="invalid-feedback">Postal code required.</div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-floating">
                                    <select id="country" class="form-select" required>
                                        <option value="">Select</option>
                                        <option>Pakistan</option>
                                        <option>India</option>
                                        <option>United States</option>
                                        <option>United Kingdom</option>
                                    </select>
                                    <label for="country">Country</label>
                                    <div class="invalid-feedback">Select a country.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h5>Payment Method</h5>

                        <div class="form-check mb-2">
                            <input type="radio" name="payment" id="card" value="card" class="form-check-input">
                            <label class="form-check-label" for="card">Credit/Debit Card</label>
                        </div>

                        <div class="form-check mb-2">
                            <input type="radio" name="payment" id="cod" value="cod" class="form-check-input">
                            <label class="form-check-label" for="cod">Cash on Delivery</label>
                        </div>

                        <div class="form-check mb-3">
                            <input type="radio" name="payment" id="wallet" value="wallet" class="form-check-input">
                            <label class="form-check-label" for="wallet">Digital Wallet</label>
                        </div>

                        <div id="card-details" class="hidden">
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="form-floating">
                                        <input type="text" id="cardholder" class="form-control" placeholder="Cardholder Name">
                                        <label for="cardholder">Cardholder Name</label>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="form-floating">
                                        <input type="text" id="cardnum" class="form-control" placeholder="1234 5678 9012 3456">
                                        <label for="cardnum">Card Number</label>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="form-floating">
                                        <input type="text" id="expiry" class="form-control" placeholder="MM/YY">
                                        <label for="expiry">Expiry</label>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="form-floating">
                                        <input type="text" id="cvv" class="form-control" placeholder="CVV">
                                        <label for="cvv">CVV</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input type="checkbox" id="terms" class="form-check-input" required>
                            <label for="terms" class="form-check-label">
                                I agree to the <a href="/terms">terms & conditions</a>
                            </label>
                        </div>

                        <button type="submit" class="place-order">Continue to Review Order →</button>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-5">
                <div class="card order-summary">
                    <div class="card-body">
                        <h5 class="d-flex justify-content-between">
                            <span>Order Summary</span>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearCartItems()">Clear Cart</button>
                        </h5>

                        <ul id="cart-items-list" class="list-group mb-3"></ul>

                        <!-- Coupon Code Section -->
                        <div class="coupon-section">
                            <label for="coupon-code" class="form-label">
                                Have a coupon code?
                                <span class="coupon-badge" title="Available coupons">SAVE10</span>
                                <span class="coupon-badge" title="Available coupons">SAVE20</span>
                            </label>
                            <div class="coupon-input-group">
                                <input type="text" 
                                       id="coupon-code" 
                                       class="form-control" 
                                       placeholder="Enter coupon code"
                                       style="text-transform: uppercase;">
                                <button type="button" 
                                        class="btn btn-outline-primary" 
                                        onclick="validateCoupon()">
                                    Apply
                                </button>
                            </div>
                            <small class="text-muted">Discount will be applied on the next page</small>
                        </div>

                        <div class="d-flex justify-content-between"><span>Subtotal:</span><span id="subtotal">PKR 0.00</span></div>
                        <div class="d-flex justify-content-between"><span>Shipping:</span><span id="shipping">PKR 0.00</span></div>
                        <div class="d-flex justify-content-between"><span>Tax:</span><span id="tax">PKR 0.00</span></div>
                        <hr>
                        <div class="d-flex justify-content-between"><strong>Total:</strong><strong id="total">PKR 0.00</strong></div>
                        <small class="text-muted" id="discount-note" style="display: none;">
                            * Discount will be applied in the next step
                        </small>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

<%- script = `
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/javascripts/checkout-cart.js"></script>
<script src="/javascripts/checkout-validate-updated.js"></script>
<script>
    // Validate coupon code
    function validateCoupon() {
        const couponCode = document.getElementById('coupon-code').value.trim().toUpperCase();
        const validCoupons = ['SAVE10', 'SAVE20', 'WELCOME15', 'FREESHIP'];
        
        if (validCoupons.includes(couponCode)) {
            document.getElementById('discount-note').style.display = 'block';
            alert('✓ Coupon code valid! Discount will be applied on the review page.');
        } else if (couponCode) {
            alert('✗ Invalid coupon code. Please try again.');
            document.getElementById('coupon-code').value = '';
            document.getElementById('discount-note').style.display = 'none';
        }
    }
    
    // Allow enter key in coupon field
    document.getElementById('coupon-code')?.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            validateCoupon();
        }
    });
</script>
` %>

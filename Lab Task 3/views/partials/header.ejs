<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title><%= title || 'beVideo' %></title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    
    <link rel="stylesheet" href="/css/style.css">
    <% if (typeof additionalCSS !== 'undefined') { %>
        <% additionalCSS.forEach(css => { %>
            <link rel="stylesheet" href="<%= css %>">
        <% }); %>
    <% } %>
</head>
<body>
    <header class="header">
        <div id="menu-container">
            <a href="/">HOME</a>
            <a href="/">ABOUT BEVIDEO</a>
            <a href="/">OUR PORTFOLIO</a>
            <a href="/">OUR STUFF</a>
            <a href="/">HIRE US</a>
            <a href="#" id="close"><span>&#x2715</span></a>
        </div>

        <div class="topbar">
            <a href="/" id="beVideo"><img src="/assets/beVideo.png" id="logo" alt="beVideo logo"></a>
            <a href="#menu-container" id="menuBar"><img src="/assets/menu.png" id="bar" alt="menu bar"></a>
        </div>
    </header>

    <a href="/checkout" id="chkout"><img src="/images/checkout.png" alt="Checkout"></a>

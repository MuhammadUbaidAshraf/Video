<%- include('partials/header', { title }) %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-lg border-success">
        <div class="card-body text-center p-5">
          <div class="success-icon mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-check-circle-fill text-success" viewBox="0 0 16 16">
              <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
          </div>
          
          <h2 class="text-success mb-3">Order Placed Successfully!</h2>
          <p class="lead mb-4">Thank you for your purchase. Your order has been confirmed.</p>
          
          <div class="alert alert-info mb-4">
            <h5 class="alert-heading">Order Number</h5>
            <p class="mb-0 fs-4 font-monospace"><strong><%= order.orderNumber %></strong></p>
            <small class="text-muted">Please save this number for your records</small>
          </div>

          <div class="row text-start mb-4">
            <div class="col-md-6">
              <h6 class="text-muted">Order Date</h6>
              <p><%= new Date(order.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
              
              <h6 class="text-muted mt-3">Order Status</h6>
              <p><span class="badge bg-success"><%= order.status %></span></p>
              
              <h6 class="text-muted mt-3">Payment Method</h6>
              <p>
                <% if (order.payment.method === 'card') { %>
                  Credit/Debit Card
                <% } else if (order.payment.method === 'cod') { %>
                  Cash on Delivery
                <% } else if (order.payment.method === 'wallet') { %>
                  Digital Wallet
                <% } %>
              </p>
            </div>
            <div class="col-md-6">
              <h6 class="text-muted">Delivery Address</h6>
              <p>
                <%= order.customer.fullname %><br>
                <%= order.customer.address %><br>
                <%= order.customer.city %>, <%= order.customer.postal %><br>
                <%= order.customer.country %>
              </p>
            </div>
          </div>

          <div class="card mb-4">
            <div class="card-header bg-light">
              <h5 class="mb-0">Order Summary</h5>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-sm mb-0">
                  <thead>
                    <tr>
                      <th>Item</th>
                      <th class="text-center">Qty</th>
                      <th class="text-end">Price</th>
                      <th class="text-end">Total</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% order.items.forEach(item => { %>
                      <tr>
                        <td><%= item.name %></td>
                        <td class="text-center"><%= item.quantity %></td>
                        <td class="text-end">PKR <%= item.price.toFixed(2) %></td>
                        <td class="text-end">PKR <%= item.subtotal.toFixed(2) %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                  <tfoot>
                    <tr>
                      <td colspan="3" class="text-end">Subtotal:</td>
                      <td class="text-end">PKR <%= order.subtotal.toFixed(2) %></td>
                    </tr>
                    <tr>
                      <td colspan="3" class="text-end">Shipping:</td>
                      <td class="text-end">PKR <%= order.shipping.toFixed(2) %></td>
                    </tr>
                    <tr>
                      <td colspan="3" class="text-end">Tax:</td>
                      <td class="text-end">PKR <%= order.tax.toFixed(2) %></td>
                    </tr>
                    <% if (order.discount > 0) { %>
                      <tr class="text-success">
                        <td colspan="3" class="text-end">Discount<% if (order.couponCode) { %> (<%= order.couponCode %>)<% } %>:</td>
                        <td class="text-end">-PKR <%= order.discount.toFixed(2) %></td>
                      </tr>
                    <% } %>
                    <tr class="fw-bold">
                      <td colspan="3" class="text-end">Grand Total:</td>
                      <td class="text-end text-success">PKR <%= order.total.toFixed(2) %></td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </div>
          </div>

          <div class="alert alert-success mb-4">
            <p class="mb-0"><strong>What's Next?</strong></p>
            <p class="small mb-0">You will receive a confirmation email at <strong><%= order.customer.email %></strong> with your order details and tracking information.</p>
          </div>

          <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a href="/" class="btn btn-primary btn-lg px-4">Continue Shopping</a>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-lg px-4">Print Receipt</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% 
const inlineJS = `
<script>
  localStorage.removeItem('cart');
  if (typeof updateCartCount === 'function') {
    updateCartCount();
  }
</script>
`;
%>

<%- include('partials/footer', { inlineJS }) %>
